 "poems": [
  {
   "seq": "1",
   "text": "春霞たつやをそきと山川の岩間をくゝる音聞ゆなり",
   "kana": "",
   "speaker": "泉式部十首",
   "page": 233,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "2",
   "text": "さひしさに煙をたにもたえしとて柴折くふる冬の山里",
   "kana": "",
   "speaker": "",
   "page": 233,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "3",
   "text": "津の國のこや共人をみるへきにひまこそなけれ蘆の八重ふき",
   "kana": "",
   "speaker": "",
   "page": 233,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "4",
   "text": "黑髪のみたれもしらす打ふせはまつかきやりし人そ戀しき",
   "kana": "",
   "speaker": "",
   "page": 233,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "5",
   "text": "かるもかき臥猪の床もいを安みさこそねさらめかゝらすも哉",
   "kana": "",
   "speaker": "",
   "page": 233,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "6",
   "text": "捨はてんと思ふさへこそ悲しけれ君になれにし我身と思へは",
   "kana": "",
   "speaker": "",
   "page": 233,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "7",
   "text": "ものをのみ思ひし程に戀しくてあさちか原によは成にけり",
   "kana": "",
   "speaker": "",
   "page": 233,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "8",
   "text": "ものおもへは澤の螢も我身よりあくかれ出る玉かとそ見る",
   "kana": "",
   "speaker": "",
   "page": 233,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "9",
   "text": "もろともに苔の下にはくちずして埋れぬ名をきくそかなしき",
   "kana": "",
   "speaker": "",
   "page": 233,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "10",
   "text": "くらきよりくらき道にそ入ぬへきはるかにてらせ山のはの月",
   "kana": "",
   "speaker": "五十九後六々撰",
   "page": 234,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "11",
   "text": "見わたせは波のしからみかけてけりうのはな咲る玉川のさと",
   "kana": "",
   "speaker": "相摸十首",
   "page": 234,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "12",
   "text": "五月雨の空なつかしく匂ふ也花橘に風やふくらむ",
   "kana": "",
   "speaker": "",
   "page": 234,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "13",
   "text": "五月雨はみつの御牧のまこも草かりほす程もあらしとそ思ふ",
   "kana": "",
   "speaker": "",
   "page": 234,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "14",
   "text": "都には初雪ふれは小野山にまきのすみかまたきまさるらん",
   "kana": "",
   "speaker": "",
   "page": 234,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "15",
   "text": "難波かたあさみつしほに立千鳥浦傳ひする聲聞ゆなり",
   "kana": "",
   "speaker": "",
   "page": 234,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "16",
   "text": "逢事のなきよりかねてつらけれはさそあらましにぬるゝ袖哉",
   "kana": "",
   "speaker": "",
   "page": 234,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "17",
   "text": "あやしくも現れぬへき袂かな忍ひねにのみぬらすと思ふに",
   "kana": "",
   "speaker": "",
   "page": 234,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "18",
   "text": "眺めつゝ〓とありかほに暮しても必す夢にみえはこそあらめ",
   "kana": "",
   "speaker": "",
   "page": 234,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "19",
   "text": "昨日けふ歎くはかりの心地せはあすに我身や逢はしとすらん",
   "kana": "",
   "speaker": "",
   "page": 234,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "20",
   "text": "恨みわひほさぬ袖たにある物を戀にくちなむ名、そおしけれ",
   "kana": "",
   "speaker": "",
   "page": 234,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "21",
   "text": "あさち原ぬしなき宿の櫻花心やすくや風にちるらむ",
   "kana": "",
   "speaker": "惠慶法師八首",
   "page": 234,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "22",
   "text": "山吹の花のさかりにゐてにきて此里人に成ぬへきかな",
   "kana": "",
   "speaker": "",
   "page": 234,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "23",
   "text": "松風のいはひの水をむすひあけて夏なき年と思ひける哉",
   "kana": "",
   "speaker": "",
   "page": 234,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "24",
   "text": "やゑ葎しけれるやとのさひしきに人こそとはね秋はきにけり",
   "kana": "",
   "speaker": "",
   "page": 234,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "25",
   "text": "徒にすくる月日を七夕のあふ夜のかすとおもはましかは",
   "kana": "",
   "speaker": "",
   "page": 234,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "26",
   "text": "荻の葉もやゝうちそよく程なるをなと鹿のれのをとなかる覽",
   "kana": "",
   "speaker": "",
   "page": 234,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "27",
   "text": "すたきけん昔の人もなき宿もたゝ影するは秋のよの月",
   "kana": "",
   "speaker": "",
   "page": 234,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "28",
   "text": "天のはら空さへさえやわたるらむ氷とみゆる冬のよの月",
   "kana": "",
   "speaker": "",
   "page": 234,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "29",
   "text": "紫の袖かつらねてきたるかな春立とはこれそうれしき",
   "kana": "",
   "speaker": "赤染八首",
   "page": 234,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "30",
   "text": "歸る〓雲井はるかになりぬなり又こむ秋もとをしと思ふに",
   "kana": "",
   "speaker": "",
   "page": 234,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "31",
   "text": "ないぬ夜もなく夜も更に郭公まつとてやすきいやはねらるゝ",
   "kana": "",
   "speaker": "",
   "page": 234,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "32",
   "text": "越はてはみやこも遠く成ぬへし關の夕風しはしすゝまん",
   "kana": "",
   "speaker": "",
   "page": 234,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "33",
   "text": "恨むとも今はみえしと思ふこそせめてつらさのまさる成けれ",
   "kana": "",
   "speaker": "",
   "page": 234,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "34",
   "text": "かはらんと祈る命はおしからてさてもわかれん〓とそかなしき",
   "kana": "",
   "speaker": "",
   "page": 234,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "35",
   "text": "我計りなからのはしもくちにけりなにはの〓ともふかく悲しき",
   "kana": "",
   "speaker": "",
   "page": 234,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "36",
   "text": "心あらん人にみせはやつのくにの難波わたりの春のけしきを",
   "kana": "",
   "speaker": "能因八首",
   "page": 234,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "37",
   "text": "世中をおもひ捨てし身なれとも心かはしと花にみえつる",
   "kana": "",
   "speaker": "",
   "page": 234,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "38",
   "text": "我やとの梢の夏になる時はいこまの山そみえすなり行",
   "kana": "",
   "speaker": "",
   "page": 234,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "39",
   "text": "時鳥來なかぬよひのしるからはぬるよも一夜あらましものを",
   "kana": "",
   "speaker": "",
   "page": 234,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "40",
   "text": "いかならん今宵の雨にとこなつのけさたに露のおもけ成つる",
   "kana": "",
   "speaker": "",
   "page": 234,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "41",
   "text": "あらし吹み室の山のもみち葉はたつたの川のにしき成けり",
   "kana": "",
   "speaker": "",
   "page": 234,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "42",
   "text": "主なしとこたふる人はなけれとも宿の景色そいふにまされる",
   "kana": "",
   "speaker": "",
   "page": 234,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "43",
   "text": "都をは霞とゝもに出しかと秋かせそ吹しら川の關",
   "kana": "",
   "speaker": "",
   "page": 234,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "44",
   "text": "古の奈良の都の八櫻重けふこゝのへににほひぬるかな",
   "kana": "",
   "speaker": "伊勢大輔八首",
   "page": 234,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "45",
   "text": "聞つともきかすともなし郭公心まとはすさよのひとこゑ",
   "kana": "",
   "speaker": "",
   "page": 234,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "46",
   "text": "小夜更て衣してうつ聲きけはいそかぬ人のねられさりけり",
   "kana": "",
   "speaker": "",
   "page": 234,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "47",
   "text": "めもかれすみつゝくらさむ白菊の花より後の花しなけれは",
   "kana": "",
   "speaker": "",
   "page": 234,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "48",
   "text": "けふくるゝ程まつたにも久しきにいかて心をかけてすきけん",
   "kana": "",
   "speaker": "",
   "page": 234,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "49",
   "text": "みるめこそあふみの海にかたからめ吹たに通へしかの浦風",
   "kana": "",
   "speaker": "",
   "page": 234,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "50",
   "text": "いにしへにふり行身こそ哀なれ昔なからの橋をみるにも",
   "kana": "",
   "speaker": "",
   "page": 234,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "51",
   "text": "なき數を思ひなしてやとはさらんまた有明の月まつものを",
   "kana": "",
   "speaker": "",
   "page": 234,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "52",
   "text": "みしま江につのくみ渡るあしのねは一夜の程に春はきにけり",
   "kana": "",
   "speaker": "好忠六首",
   "page": 234,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "53",
   "text": "さかきとる卯月になれは神山の楢の葉かしはもとつばもなし",
   "kana": "",
   "speaker": "",
   "page": 234,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "54",
   "text": "みたやもりけふは五月に成にけり急けや早苗おいもこそすれ",
   "kana": "",
   "speaker": "",
   "page": 234,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "55",
   "text": "なけやなけよもきかもとのきり〓〓す過行秋はけにそ悲しき",
   "kana": "",
   "speaker": "",
   "page": 234,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "56",
   "text": "我せこかきまさぬよひの秋風はこぬ人よりもうらめしき哉",
   "kana": "",
   "speaker": "",
   "page": 234,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "57",
   "text": "あちきなし我身にまさる物やあると戀せし人をもときし物を",
   "kana": "",
   "speaker": "",
   "page": 234,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "58",
   "text": "花みると人は山邊に入はてゝ春は都そさひしかりけり",
   "kana": "",
   "speaker": "道命六首",
   "page": 234,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "59",
   "text": "あし引の山ほとゝきすのみならす大かた鳥の聲もきこえす",
   "kana": "",
   "speaker": "",
   "page": 234,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "60",
   "text": "郭公まつほとゝこそ思ひつれ聞ての後はねられさりけり",
   "kana": "",
   "speaker": "",
   "page": 234,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "61",
   "text": "古〓はあさちか原と成はてゝ夜すから虫の音をのみそ鳴",
   "kana": "",
   "speaker": "",
   "page": 234,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "62",
   "text": "思ひあまりいひ出る程に數ならぬ身をさへ人にしられぬる哉",
   "kana": "",
   "speaker": "",
   "page": 234,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "63",
   "text": "わするなよわするときかは三熊野の浦のはまゆふ恨かさねん",
   "kana": "",
   "speaker": "",
   "page": 234,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "64",
   "text": "五月やみくらはし山のほとゝきすおほつかなくも鳴わたる哉",
   "kana": "",
   "speaker": "實方五首",
   "page": 234,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "65",
   "text": "なにせんに命をかけて誓ひけんいかはやと思ふ折もこそあれ",
   "kana": "",
   "speaker": "",
   "page": 234,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "66",
   "text": "契ありて此世に又は生るともおもかはりしてみもや忘れん",
   "kana": "",
   "speaker": "",
   "page": 234,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "67",
   "text": "浦風に靡きにけりな里の海人のたくもの烟心よはさは",
   "kana": "",
   "speaker": "",
   "page": 234,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "68",
   "text": "忘れすよ又わすれすもかはら屋の下たく煙したむせひつゝ",
   "kana": "",
   "speaker": "",
   "page": 234,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "69",
   "text": "近江にか有といふなるみくりくる人くるしめのつくまえの沼",
   "kana": "",
   "speaker": "道信五首",
   "page": 234,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "70",
   "text": "歸るさの道やはかはるかはらねととくるはまとふけさの朝雪",
   "kana": "",
   "speaker": "",
   "page": 234,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "71",
   "text": "明ぬれはくるゝものとはしりなから猶うらめしき朝ほらけ哉",
   "kana": "",
   "speaker": "",
   "page": 234,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "72",
   "text": "朝顔を何はかなしと思ひけん人をも花はさこそ見るらめ",
   "kana": "",
   "speaker": "",
   "page": 234,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "73",
   "text": "限りあれはけふぬき捨つ藤衣はてなき物はなみた成けり",
   "kana": "",
   "speaker": "",
   "page": 234,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "74",
   "text": "今よりはうへてたにみし花すゝきほに出る秋はわひしかり鳬",
   "kana": "",
   "speaker": "貞文三首",
   "page": 234,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "75",
   "text": "秋風の吹うらかへすくすの葉のうらみてもなを恨めしきかな",
   "kana": "",
   "speaker": "",
   "page": 234,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "76",
   "text": "ありはてぬ命まつまのほとはかり憂事しけく歎かすもかな",
   "kana": "",
   "speaker": "",
   "page": 234,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "77",
   "text": "夏の夜のまた宵なから明ぬるを雲のいつくに月宿るらん",
   "kana": "",
   "speaker": "深養父四首",
   "page": 234,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "78",
   "text": "雲ゐにもふかき心のをくれねはわかると人にみゆるはかりそ",
   "kana": "",
   "speaker": "",
   "page": 234,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "79",
   "text": "心をそわりなきものと思ひぬるみるものからや戀しかるへき",
   "kana": "",
   "speaker": "",
   "page": 234,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "80",
   "text": "戀しなはたか名はたしゝ世中の常なきものといひはなすとも",
   "kana": "",
   "speaker": "",
   "page": 234,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "81",
   "text": "梅か香を夜はのあらしの吹ためて槇の板との明る待けり",
   "kana": "",
   "speaker": "嘉言四首",
   "page": 234,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "82",
   "text": "いつかたと聞たにわかす郭公たゝ一こゑの心まとひに",
   "kana": "",
   "speaker": "",
   "page": 234,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "83",
   "text": "忍ひつゝやみなんよりは思ふ〓ああけりとたに人にしらせん",
   "kana": "",
   "speaker": "",
   "page": 234,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "84",
   "text": "君か代は千世に一たひゐるちりの白雲かゝる山となるまて",
   "kana": "",
   "speaker": "",
   "page": 234,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "85",
   "text": "いとゝしくなくさめかたき夕暮に秋とおほゆる風そ吹なる",
   "kana": "",
   "speaker": "道濟四首",
   "page": 234,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "86",
   "text": "あさほらけ雪ふるさとを見わたせは山のは〓とに月そ殘れる",
   "kana": "",
   "speaker": "",
   "page": 234,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "87",
   "text": "ぬれ〓〓も猶かりゆかむはし鷹のうはけの雪を打はらひつゝ",
   "kana": "",
   "speaker": "",
   "page": 234,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "88",
   "text": "行末のしるしはかりに殘るへき松さへいたく老にけるかな",
   "kana": "",
   "speaker": "",
   "page": 234,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "89",
   "text": "柳葉のゆふしてかけてそのかみにをしかへしてもにたる比哉",
   "kana": "",
   "speaker": "道雅四首",
   "page": 234,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "90",
   "text": "あふさかは東路とこそ聞しかと心つくしの關にそ有ける",
   "kana": "",
   "speaker": "",
   "page": 234,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "91",
   "text": "いまはたゝ思ひたえなむとはかりを人傳ならて云よしもかな",
   "kana": "",
   "speaker": "",
   "page": 234,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "92",
   "text": "涙やば又もあふへきつまならんなくよりほかの慰めそなき",
   "kana": "",
   "speaker": "",
   "page": 234,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "93",
   "text": "冬の夜に幾たひはかりね覺してもの思ふ宿のひましらむらん",
   "kana": "",
   "speaker": "增基四首",
   "page": 234,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "94",
   "text": "都のみかへりみられて東路を駒の心にまかせてそ行く",
   "kana": "",
   "speaker": "",
   "page": 234,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "95",
   "text": "山からす頭もしろく成にけり我かへるへき時やしるらん",
   "kana": "",
   "speaker": "",
   "page": 234,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "96",
   "text": "ともすれはかりの山邊にあくかれし心に身をもまかせつる哉",
   "kana": "",
   "speaker": "",
   "page": 234,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "97",
   "text": "年の内に春はきにけり一年をこそとやいはん今年とやいはむ",
   "kana": "",
   "speaker": "元方三首",
   "page": 235,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "98",
   "text": "たちかへり哀とそ思ふよそにても人に心をおきつしら波",
   "kana": "",
   "speaker": "",
   "page": 235,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "99",
   "text": "人はいさ我はなき名のおしけれは昔も今もしらすとをいはん",
   "kana": "",
   "speaker": "",
   "page": 235,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "100",
   "text": "月みれはちゝに物こそ悲しけれ我身ひとつの秋にはあらねと",
   "kana": "",
   "speaker": "千",
   "page": 235,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "101",
   "text": "あし田鶴のひとりをくれて啼こふは雲のうへまて聞えつか南",
   "kana": "",
   "speaker": "",
   "page": 235,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "102",
   "text": "うへし時花待とをにありし菊うつろふ秋にあはむとや見し",
   "kana": "",
   "speaker": "",
   "page": 235,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "103",
   "text": "春きてそ人もとひける山里は花こそ宿のあるし成けれ",
   "kana": "",
   "speaker": "公任三首",
   "page": 235,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "104",
   "text": "朝またき嵐のかせのさむけれは散るもみち葉をきぬ人そなき",
   "kana": "",
   "speaker": "",
   "page": 235,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "105",
   "text": "霜をかぬ袖たにさゆる冬の夜の鴨のうは毛を思ひこそやれ",
   "kana": "",
   "speaker": "",
   "page": 235,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "106",
   "text": "いつれをかわきておらまし山櫻心うつらぬ枝しなけれは",
   "kana": "",
   "speaker": "輔親三首",
   "page": 235,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "107",
   "text": "あし曳の山郭公さとなれてたそかれ時になのりすらしも",
   "kana": "",
   "speaker": "",
   "page": 235,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "108",
   "text": "いかて〓〓こふる心を慰めて後の世まてにものを思はし",
   "kana": "",
   "speaker": "",
   "page": 235,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "109",
   "text": "沼水にかはつ鳴なりむへしこそ岸の山吹さかりなりけれ",
   "kana": "",
   "speaker": "高遠三首",
   "page": 235,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "110",
   "text": "逢坂の關のいはかとふみならし山たちいつる霧はらの駒",
   "kana": "",
   "speaker": "",
   "page": 235,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "111",
   "text": "戀しくは夢にも人をみるへきに窓うつ雨そめをさましつゝ",
   "kana": "",
   "speaker": "",
   "page": 235,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "112",
   "text": "とゝまらぬ心そみえむかりかねは花の盛を人にかたるな",
   "kana": "",
   "speaker": "馬内侍三首",
   "page": 235,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "113",
   "text": "こよひ君いかなる里の月をみて都に誰をおもひ出らん",
   "kana": "",
   "speaker": "",
   "page": 235,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "114",
   "text": "かきくもれ時雨とならは神無月心そらなる人やとまると",
   "kana": "",
   "speaker": "",
   "page": 235,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "115",
   "text": "つらからは人にかたらんしきたへの枕かはして一夜ねてきと",
   "kana": "",
   "speaker": "義孝三首",
   "page": 235,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "116",
   "text": "君かためおしからさりし命さへなかくもかなと思ひけるかな",
   "kana": "",
   "speaker": "",
   "page": 235,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "117",
   "text": "今はとてとひわかるめる村鳥のふるすにひとりなかむへき哉",
   "kana": "",
   "speaker": "",
   "page": 235,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "118",
   "text": "みよし野は春のけしきにかすめともむすほをれたる雪の下草",
   "kana": "",
   "speaker": "紫式部三首",
   "page": 235,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "119",
   "text": "世中をなに歎かまし山さくら花みるほとの心なりせは",
   "kana": "",
   "speaker": "",
   "page": 235,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "120",
   "text": "めつらしき光さしそふ杯はもちなからこそ千世もめくらめ",
   "kana": "",
   "speaker": "",
   "page": 235,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "121",
   "text": "身にかへてあやなく花を惜むかないけらは後の春もこそあれ",
   "kana": "",
   "speaker": "長能三首",
   "page": 235,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "122",
   "text": "さはへなす荒ふる神とをしなへて今日はなこしのはらひ成鳬",
   "kana": "",
   "speaker": "",
   "page": 235,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "123",
   "text": "雪をうすみ垣ねにつめるから薺なつさはまくのほしき君哉",
   "kana": "",
   "speaker": "",
   "page": 235,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "124",
   "text": "櫻花さかりになれは古〓のむくらのかともさゝれさりけり",
   "kana": "",
   "speaker": "定賴三首",
   "page": 235,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "125",
   "text": "水もなくみえこそわたれ大井川きしの紅葉は雨とふれとも",
   "kana": "",
   "speaker": "",
   "page": 235,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "126",
   "text": "かりそめの別と思へとしら川のせきとめかたき淚なりけり",
   "kana": "",
   "speaker": "",
   "page": 235,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "127",
   "text": "思ひやれ霞こめたる山里の花まつほとの春のつれ/",
   "kana": "",
   "speaker": "上東門院中將三首",
   "page": 235,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "128",
   "text": "此頃は木〓のこすゑも紅葉して鹿こそはなけ秋の山里",
   "kana": "",
   "speaker": "",
   "page": 235,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "129",
   "text": "おもひやれとふ人もなきやま里のかけひの水の心ほそさを",
   "kana": "",
   "speaker": "",
   "page": 235,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "130",
   "text": "けふよりは荻の燒はらかき分て若菜つみにと誰をさそはん",
   "kana": "",
   "speaker": "兼覽王二首",
   "page": 235,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "131",
   "text": "立田姬たむくる神のあれはこそ秋の木の葉のぬさと散らめ",
   "kana": "",
   "speaker": "",
   "page": 235,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "132",
   "text": "春たてと花もにほはぬわか宿は物うかるねに鶯のなく",
   "kana": "",
   "speaker": "棟梁ニ首",
   "page": 235,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "133",
   "text": "秋の野の草のたもとか花すゝきほに出てまねく袖とみゆらん",
   "kana": "",
   "speaker": "",
   "page": 235,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "134",
   "text": "春の日のひかりにあたる我なれとかしらの雪となるそ侘しき",
   "kana": "",
   "speaker": "康秀二首",
   "page": 235,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "135",
   "text": "吹からに野への草木のしほるれはむへ山風をあらしといふ覽",
   "kana": "",
   "speaker": "",
   "page": 235,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "136",
   "text": "きり〓〓すいたくな鳴そ秋の夜の長き思ひはわれそまされる",
   "kana": "",
   "speaker": "忠房ニ首",
   "page": 235,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "137",
   "text": "なをさりの淚なりせはから衣忍ひに袖のしほらさらまし",
   "kana": "",
   "speaker": "",
   "page": 235,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "138",
   "text": "春風はのとけかるへし八重よりもかさねて匂へ山ふきの花",
   "kana": "",
   "speaker": "輔昭ニ首",
   "page": 235,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "139",
   "text": "またしらぬ古〓人はけふまてやこむとたのめし我を待らん",
   "kana": "",
   "speaker": "",
   "page": 235,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "140",
   "text": "逢坂の關のあなたをまた見ねは東の〓ともしられさりけり",
   "kana": "",
   "speaker": "匡衡ニ首",
   "page": 235,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "141",
   "text": "川舟にのりて心のゆく時はしつめる身ともおほえさりけり",
   "kana": "",
   "speaker": "",
   "page": 235,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "142",
   "text": "夏衣またひとへなるうたゝねに心してふけ秋の川風",
   "kana": "",
   "speaker": "安法ニ首",
   "page": 235,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "143",
   "text": "天くたるあら人神のあひおひを思へはひさし住よしの松",
   "kana": "",
   "speaker": "",
   "page": 235,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "144",
   "text": "夜をこめて鳥のそらねははかるとも世に逢坂の關はゆるさし",
   "kana": "",
   "speaker": "〓少納言ニ首",
   "page": 235,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "145",
   "text": "よしさらはつらきは我に習ひ鳬たのめてこぬは誰かをしへし",
   "kana": "",
   "speaker": "",
   "page": 235,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  }
 ],
 "catalog": {
  "work_id": "gunsho07-go-rokurokusen",
